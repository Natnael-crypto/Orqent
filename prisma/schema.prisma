generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  companyName      String?
  role             String            @default("USER")
  isEmailVerified  Boolean           @default(false)
  password         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  allowedDomains   AllowedDomain[]
  integrations     Integration[]
  uiCustomizations UICustomization[]
  widgets          Widget[]
  oauthTokens      OAuthToken[]
  tokenUsages      TokenUsage[]

  @@index([email])
  @@map("users")
}

model VerificationCode {
  id        String   @id @default(uuid())
  code      String
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([code])
  @@map("verification_codes")
}

model Widget {
  id                String           @id @default(uuid())
  userId            String
  name              String
  description       String?
  status            String           @default("ACTIVE")
  model             String           @default("gpt-4")
  systemPrompt      String
  temperature       Float            @default(0.7)
  maxTokens         Int              @default(1000)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  uiCustomizationId String?
  allowedDomains    AllowedDomain[]
  uiCustomization   UICustomization? @relation(fields: [uiCustomizationId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrations      Integration[]    @relation("IntegrationToWidget")
  conversations     Conversation[]

  @@index([userId])
  @@index([status])
  @@index([model])
  @@index([uiCustomizationId])
  @@map("widgets")
}

model Conversation {
  id          String   @id @default(uuid())
  widgetId    String
  externalId  String? // ID from the host website context if any
  visitorId   String? // Anonymous visitor tracking
  lastMessage String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  widget      Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([widgetId])
  @@index([visitorId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String // "user" | "assistant" | "system"
  content        String
  tokens         Int?
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model UICustomization {
  id                String   @id @default(uuid())
  name              String
  userId            String
  chatButtonText    String   @default("Chat")
  agentName         String   @default("AI Assistant")
  welcomeMessage    String   @default("Hello! How can I help you?")
  primaryColor      String   @default("#000000")
  backgroundColor   String   @default("#ffffff")
  borderRadius      Int      @default(8)
  fontSize          Int      @default(16)
  height            Int      @default(600)
  width             Int      @default(400)
  position          String   @default("right")
  chatButtonLogoUrl String?
  agentAvatarUrl    String?
  showPoweredBy     Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgets           Widget[]

  @@index([userId])
  @@map("ui_customizations")
}

model AllowedDomain {
  id        String   @id @default(uuid())
  userId    String
  widgetId  String
  domain    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widget    Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([widgetId])
  @@index([userId])
  @@map("allowed_domains")
}

model Integration {
  id          String             @id @default(uuid())
  userId      String
  name        String
  type        String
  status      String             @default("ACTIVE")
  description String?
  config      Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  restTools   RestTool[]
  widgets     Widget[]           @relation("IntegrationToWidget")
  logs        ToolExecutionLog[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("integrations")
}

model RestTool {
  id                   String             @id @default(uuid())
  integrationId        String
  method               String             @default("GET")
  path                 String
  contentType          String             @default("application/json")
  headers              Json?
  requestConfig        Json
  responseConfig       Json
  requiresConfirmation Boolean            @default(false)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  integration          Integration        @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  logs                 ToolExecutionLog[]

  @@index([integrationId])
  @@map("rest_tools")
}

model ToolExecutionLog {
  id              String      @id @default(uuid())
  integrationId   String
  toolId          String
  conversationId  String
  requestPayload  Json
  responsePayload Json
  status          String // "SUCCESS" | "FAILED"
  errorMessage    String?
  latencyMs       Int
  tokensUsed      Int?
  createdAt       DateTime    @default(now())
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tool            RestTool    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([toolId])
  @@index([conversationId])
  @@map("tool_execution_logs")
}

model OAuthToken {
  id           String    @id @default(uuid())
  userId       String
  provider     String    // "google", "slack", etc.
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiryDate   DateTime?
  scopes       String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@map("oauth_tokens")
}

model TokenUsage {
  id              String   @id @default(uuid())
  userId          String
  widgetId        String?
  conversationId  String?
  messageId       String?  @unique
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  role            String   @default("assistant")
  model           String?
  cost            Float    @default(0)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([widgetId])
  @@index([createdAt])
  @@map("token_usages")
}
